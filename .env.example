# Copie en .env (ou .env.local) — jamais commité.

# Force le stub d'achats (achats simulés, sans store). Défaut : actif en dev.
EXPO_PUBLIC_PURCHASES_STUB=1

# Clés RevenueCat — à renseigner quand `react-native-purchases` est branché.
# EXPO_PUBLIC_RC_IOS_KEY=appl_xxx
# EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxx
